<?xml version="1.0" encoding="utf-8"?>
<!-- Allow cleartext HTTP to any host — the Whisper server is self-hosted on a
     private/DMZ address configured by the user; enforcing TLS here would break
     typical self-hosted setups without a certificate. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
