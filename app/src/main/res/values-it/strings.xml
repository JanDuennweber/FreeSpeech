<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">FreeSpeech</string>

    <!-- ── Selezione lingua ──────────────────────────────────────────────────── -->
    <string name="settings_language_label">Lingua</string>
    <string name="language_system_default">Lingua del telefono (predefinita)</string>

    <!-- ── Impostazioni ──────────────────────────────────────────────────────── -->
    <string name="settings_subtitle">Assistente vocale open-source per Android Auto su /e/OS</string>

    <string name="settings_whisper_url_label">URL endpoint API Whisper:</string>
    <string name="settings_whisper_url_hint">http://tuo-server:8080/v1/audio/transcriptions</string>
    <string name="settings_whisper_url_desc">Punta a qualsiasi endpoint Whisper compatibile con OpenAI (faster-whisper self-hosted, LocalAI, server whisper.cpp, ecc.)</string>

    <string name="settings_log_url_label">URL registro comandi (opzionale):</string>
    <string name="settings_log_url_hint">http://tuo-server:8081/v1/log</string>
    <string name="settings_log_url_desc">Lasciare vuoto per disabilitare. I log dei comandi anonimi (senza audio, senza dati personali) vengono inviati dopo ogni comando.</string>

    <string name="btn_save">Salva</string>

    <!-- Instradamento comandi -->
    <string name="settings_command_routing_title">Comandi vocali → App</string>
    <string name="settings_command_routing_desc">Scegli quale app si apre per ogni tipo di comando. Vengono mostrate solo le app installate.</string>
    <string name="settings_music_label">Musica  (es. riproduci David Bowie)</string>
    <string name="settings_weather_label">Meteo  (es. pioverà oggi?)</string>
    <string name="settings_nav_label">Navigazione  (es. vai alla stazione centrale di Milano)</string>
    <string name="settings_websearch_label">Ricerca web  (tutto il resto)</string>
    <string name="settings_searchengine_label">Motore di ricerca per la ricerca web:</string>
    <string name="settings_call_hint">Suggerimento: i comandi di chiamata aprono sempre il telefono — nessuna configurazione necessaria.</string>

    <!-- Sezione IA -->
    <string name="settings_ai_title">Interpretazione comandi tramite IA</string>
    <string name="settings_ai_desc">Quando attivato, FreeSpeech comprende frasi libere come \"Ho fame\" o \"un po\' di musica rock sarebbe bella\". La trascrizione viene inviata all\'IA configurata.</string>
    <string name="settings_use_ai">Usa l\'IA per l\'interpretazione dei comandi</string>
    <string name="settings_ai_engine_label">Motore IA:</string>
    <string name="settings_ai_api_key_label">Chiave API:</string>
    <string name="settings_ai_api_key_hint">Lascia vuoto per Ollama</string>
    <string name="settings_ai_api_key_desc">Gemini: chiave API gratuita su ai.google.dev — nessun metodo di pagamento richiesto.</string>
    <string name="settings_ai_base_url_label">URL base:</string>
    <string name="settings_ai_model_label">Modello:</string>

    <string name="toast_saved">Salvato</string>

    <!-- Parola di attivazione -->
    <string name="settings_wake_title">Parola di attivazione</string>
    <string name="settings_wake_desc">Quando attivato, FreeSpeech ascolta in background la parola di attivazione tramite il tuo server Whisper. Pronunciala per avviare un comando a mani libere.</string>
    <string name="settings_wake_enable">Abilita rilevamento parola di attivazione (disabilitato per impostazione predefinita)</string>
    <string name="settings_wake_word_label">Parola di attivazione:</string>
    <string name="settings_wake_word_hint">Free Speech</string>
    <string name="settings_wake_word_desc">Breve e distintiva — 2 sillabe funzionano bene. Richiede l\'URL Whisper configurato. Si attiva solo quando la schermata auto di FreeSpeech è visibile.</string>
    <string name="wake_notification_channel">Parola di attivazione</string>
    <string name="wake_notification_title">FreeSpeech — Parola di attivazione attiva</string>
    <string name="wake_notification_text">In attesa di \"%1$s\"…</string>
    <string name="wake_notification_stop">Interrompi</string>
    <!-- Console FreeSpeech -->
    <string name="settings_console_title">Console FreeSpeech</string>
    <string name="settings_console_desc">Connettiti a un server Console FreeSpeech per la classificazione IA lato server. Gli utenti anonimi usano Ollama; gli utenti registrati con chiave Gemini usano il proprio motore IA personale.</string>
    <string name="settings_console_url_label">URL della console:</string>
    <string name="settings_console_url_hint">http://tuo-server:3001</string>
    <string name="settings_console_token_label">Il tuo token API (opzionale):</string>
    <string name="settings_console_token_hint">Incolla il token dal tuo profilo Console</string>
    <string name="settings_console_token_desc">Lascia vuoto per usare la console in modo anonimo (Ollama). Registrati sulla Console per ottenere un token personale.</string>
    <string name="settings_console_active_notice">✓ IA lato server attiva — le richieste vanno alla Console FreeSpeech. Le impostazioni IA locali non vengono utilizzate.</string>

    <string name="wake_trigger_channel">Attivatore parola di attivazione</string>
    <string name="wake_trigger_title">FreeSpeech ti ha sentito!</string>
    <string name="wake_trigger_text">Tocca per aprire FreeSpeech e pronunciare il tuo comando.</string>

    <!-- Motori IA -->
    <string name="engine_gemini">Gemini (gratuito, Google)</string>
    <string name="engine_openai">OpenAI / GPT</string>
    <string name="engine_ollama">Ollama (locale, privato)</string>
    <string name="engine_anthropic">Anthropic / Claude</string>

    <!-- Descrizioni dei motori IA -->
    <string name="engine_hint_gemini">Chiave API gratuita su ai.google.dev — nessun metodo di pagamento richiesto.</string>
    <string name="engine_hint_openai">Chiave API su platform.openai.com/api-keys. Modello più economico: gpt-4o-mini.</string>
    <string name="engine_hint_ollama">Ollama funziona localmente sul tuo server — nessuna chiave API necessaria. Modello consigliato: qwen2.5:7b.</string>
    <string name="engine_hint_anthropic">Chiave API su console.anthropic.com/settings/keys. Modello predefinito: claude-3-5-haiku-20241022.</string>

