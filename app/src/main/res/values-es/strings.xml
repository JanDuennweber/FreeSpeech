    <string name="settings_subtitle">Asistente de voz de código abierto para Android Auto en /e/OS</string>

    <string name="settings_whisper_url_label">URL del punto de acceso API de Whisper:</string>
    <string name="settings_whisper_url_hint">http://tu-servidor:8080/v1/audio/transcriptions</string>
    <string name="settings_whisper_url_desc">Apunta a cualquier punto de acceso Whisper compatible con OpenAI (faster-whisper auto-alojado, LocalAI, servidor whisper.cpp, etc.)</string>

    <string name="settings_log_url_label">URL de registro de comandos (opcional):</string>
