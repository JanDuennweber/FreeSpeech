    <!-- Sección IA -->
    <string name="settings_ai_title">Interpretación de comandos por IA</string>
    <string name="settings_ai_desc">Cuando está activado, FreeSpeech entiende frases libres como \"Tengo hambre\" o \"me apetece un poco de rock\". La transcripción se envía a la IA configurada.</string>
    <string name="settings_use_ai">Usar IA para interpretar comandos</string>
    <string name="settings_ai_engine_label">Motor de IA:</string>
    <string name="settings_ai_api_key_label">Clave API:</string>
    <string name="settings_ai_api_key_hint">Dejar vacío para Ollama</string>
    <string name="settings_ai_api_key_desc">Gemini: clave API gratuita en ai.google.dev — no se requiere método de pago.</string>
    <string name="settings_ai_base_url_label">URL base:</string>
    <string name="settings_ai_model_label">Modelo:</string>

    <string name="toast_saved">Guardado</string>

    <!-- Palabra de activación -->
    <string name="settings_wake_title">Palabra de activación</string>
    <string name="settings_wake_desc">Cuando está activado, FreeSpeech escucha en segundo plano la palabra de activación a través de tu servidor Whisper. Dila para iniciar un comando sin tocar la pantalla.</string>
    <string name="settings_wake_enable">Activar detección de palabra de activación (deshabilitado por defecto)</string>
    <string name="settings_wake_word_label">Palabra de activación:</string>
    <string name="settings_wake_word_hint">Free Speech</string>
    <string name="settings_wake_word_desc">Corta y distintiva — 2 sílabas funcionan bien. Requiere la URL de Whisper configurada. Solo se activa cuando la pantalla del coche de FreeSpeech es visible.</string>
    <string name="wake_notification_channel">Palabra de activación</string>
