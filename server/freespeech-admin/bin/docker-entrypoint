#!/bin/bash
set -e

# Run database migrations on every start (safe — idempotent).
# db:prepare: loads schema on fresh DB, migrates on existing one.
echo "→ Running database migrations…"
bundle exec rails db:prepare

echo "→ Seeding defaults (idempotent — safe to run on every start)…"
bundle exec rails db:seed

echo "→ Starting Puma…"
exec "$@"
