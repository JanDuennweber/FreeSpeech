<div style="max-width:380px;margin:3rem auto">
  <h2 style="margin-bottom:1.5rem;text-align:center">Sign in to FreeSpeech Console</h2>

  <%= form_with url: login_path, method: :post, local: true do %>
    <div class="card">
      <div class="field">
        <%= label_tag :email, "Email" %>
        <%= text_field_tag :email, params[:email], type: "email",
              autofocus: true, autocomplete: "email" %>
      </div>
      <div class="field">
        <%= label_tag :password, "Password" %>
        <%= password_field_tag :password, nil, autocomplete: "current-password" %>
      </div>
      <div style="margin-top:1rem">
        <button type="submit" class="btn btn-primary" style="width:100%">Sign in</button>
      </div>
    </div>
  <% end %>

  <p style="text-align:center;margin-top:1rem;color:var(--muted);font-size:.875rem">
    No account yet?
    <%= link_to "Register", register_path %>
  </p>
</div>
