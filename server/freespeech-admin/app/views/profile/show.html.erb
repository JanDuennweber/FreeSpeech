<h2 style="margin-bottom:1.2rem">My Account</h2>

<%# ── API Token ────────────────────────────────────────────────────────────── %>
<div class="card">
  <div class="card-title">🔑 API Token</div>
  <p class="hint" style="margin-bottom:.75rem">
    Paste this token into the FreeSpeech app: <strong>Settings → FreeSpeech Console → Your Token</strong>.<br>
    It lets the app use your personal AI configuration for server-side classification.
  </p>
  <div style="font-family:monospace;font-size:.9rem;word-break:break-all;
              background:#f1f3f5;padding:.75rem;border-radius:5px;margin-bottom:.75rem">
    <%= current_user.api_token %>
  </div>
  <%= form_with url: regenerate_token_path, method: :post, local: true,
        data: { confirm: "Regenerate token? The current token will stop working immediately." } do %>
    <button type="submit" class="btn" style="background:#e9ecef;font-size:.82rem">
      ↻ Regenerate token
    </button>
  <% end %>
</div>

<%# ── AI Settings ──────────────────────────────────────────────────────────── %>
<%= form_with url: profile_path, method: :patch, local: true do |f| %>
  <div class="card">
    <div class="card-title">🤖 AI Classification (personal overrides)</div>
    <p class="hint" style="margin-bottom:1rem">
      Leave fields blank to use the server defaults (<strong><%= Setting["ai_engine"] || "ollama" %></strong> /
      <strong><%= Setting["ai_model"] || "qwen2.5:7b" %></strong>).
      Fill them to use your own engine and API key for every request you make.
    </p>
    <div class="fields-grid">
      <div class="field">
        <%= label_tag "user[ai_engine]", "Engine override" %>
        <%= select_tag "user[ai_engine]",
              options_for_select([
                ["— use server default —",   ""],
                ["Ollama (local / private)",  "ollama"],
                ["Gemini (free, Google)",     "gemini"],
                ["OpenAI / GPT",              "openai"],
              ], current_user.ai_engine.to_s) %>
      </div>
      <div class="field">
        <%= label_tag "user[ai_model]", "Model override" %>
        <%= text_field_tag "user[ai_model]", current_user.ai_model,
              placeholder: "e.g. gemini-2.0-flash-lite, qwen2.5:7b" %>
      </div>
      <div class="field">
        <%= label_tag "user[ai_base_url]", "Base URL override" %>
        <%= text_field_tag "user[ai_base_url]", current_user.ai_base_url,
              placeholder: "https://generativelanguage.googleapis.com/v1beta/openai" %>
        <div class="hint">Only needed for Ollama or custom endpoints; Gemini/OpenAI leave blank.</div>
      </div>
      <div class="field">
        <%= label_tag "user[ai_api_key]", "API Key" %>
        <%= password_field_tag "user[ai_api_key]", current_user.ai_api_key,
              placeholder: "Leave blank to use server key or Ollama",
              autocomplete: "new-password" %>
        <div class="hint">Gemini: free key at ai.google.dev · OpenAI: platform.openai.com/api-keys · Ollama: leave blank</div>
      </div>
    </div>
    <div style="margin-top:.75rem">
      <button type="submit" class="btn btn-primary">💾 Save AI settings</button>
    </div>
  </div>
<% end %>

<%# ── Change password ──────────────────────────────────────────────────────── %>
<div class="card">
  <div class="card-title">🔒 Change Password</div>
  <%= form_with url: profile_path, method: :patch, local: true do %>
    <div class="fields-grid">
      <div class="field">
        <%= label_tag :current_password, "Current password" %>
        <%= password_field_tag :current_password, nil, autocomplete: "current-password" %>
      </div>
      <div></div>
      <div class="field">
        <%= label_tag :new_password, "New password" %>
        <%= password_field_tag :new_password, nil, autocomplete: "new-password" %>
      </div>
      <div class="field">
        <%= label_tag :confirm_password, "Confirm new password" %>
        <%= password_field_tag :confirm_password, nil, autocomplete: "new-password" %>
      </div>
    </div>
    <div style="margin-top:.75rem">
      <button type="submit" class="btn btn-primary">Change password</button>
    </div>
  <% end %>
</div>

<%# ── Account info ─────────────────────────────────────────────────────────── %>
<div class="card" style="border-style:dashed">
  <div class="card-title" style="font-size:.85rem">ℹ Account info</div>
  <p class="hint">Email: <strong><%= current_user.email %></strong></p>
  <p class="hint">Role: <strong><%= current_user.role %></strong></p>
  <p class="hint">Confirmed: <strong><%= current_user.confirmed? ? "yes" : "pending email confirmation" %></strong></p>
</div>
