<div style="max-width:420px;margin:3rem auto">
  <h2 style="margin-bottom:.5rem;text-align:center">Create your FreeSpeech account</h2>
  <p class="sub" style="text-align:center;margin-bottom:1.5rem">
    Register to use a personal API key and unlock server-side AI classification.
  </p>

  <%= form_with model: @user, url: register_path, method: :post, local: true do |f| %>
    <div class="card">
      <div class="field">
        <%= f.label :email, "Email address" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email" %>
      </div>
      <div class="field">
        <%= f.label :password, "Password" %>
        <%= f.password_field :password, autocomplete: "new-password" %>
      </div>
      <div class="field">
        <%= f.label :password_confirmation, "Confirm password" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password" %>
      </div>
      <% if @user.errors.any? %>
        <div class="flash alert" style="margin:.5rem 0">
          <%= @user.errors.full_messages.join(" · ") %>
        </div>
      <% end %>
      <div style="margin-top:1rem">
        <button type="submit" class="btn btn-primary" style="width:100%">Create account</button>
      </div>
    </div>
  <% end %>

  <p style="text-align:center;margin-top:1rem;color:var(--muted);font-size:.875rem">
    Already registered? <%= link_to "Sign in", login_path %>
  </p>
</div>
