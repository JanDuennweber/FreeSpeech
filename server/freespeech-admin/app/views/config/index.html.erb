<h2 style="margin-bottom:1.2rem">Configuration</h2>

<%= form_with url: config_path, method: :patch, local: true do |f| %>

  <%# ── Whisper ─────────────────────────────────────────────────────────────── %>
  <div class="card">
    <div class="card-title">🔊 Whisper Transcription Server</div>
    <div class="fields-grid">
      <div class="field">
        <%= label_tag "settings[whisper_url]", "Endpoint URL" %>
        <%= text_field_tag "settings[whisper_url]", @settings["whisper_url"],
              placeholder: "http://localhost:8080/v1/audio/transcriptions" %>
        <div class="hint">OpenAI-compatible transcription endpoint (faster-whisper, whisper.cpp, LocalAI, …)</div>
      </div>
      <div class="field">
        <%= label_tag "settings[whisper_model]", "Model" %>
        <%= text_field_tag "settings[whisper_model]", @settings["whisper_model"],
              placeholder: "large-v3" %>
        <div class="hint">Whisper model name passed to the server (large-v3, medium, small, …)</div>
      </div>
    </div>
  </div>

  <%# ── AI Classification ──────────────────────────────────────────────────── %>
  <div class="card">
    <div class="card-title">🤖 AI Command Classification</div>
    <div class="fields-grid">
      <div class="field">
        <%= label_tag "settings[ai_engine]", "Engine" %>
        <%= select_tag "settings[ai_engine]",
              options_for_select([
                ["Ollama (local / private)",        "ollama"],
                ["Gemini (free, Google)",            "gemini"],
                ["OpenAI / GPT",                     "openai"],
                ["Anthropic / Claude",               "anthropic"],
              ], @settings["ai_engine"]) %>
        <div class="hint">Which AI backend classifies voice commands into music / navigation / weather / …</div>
      </div>
      <div class="field">
        <%= label_tag "settings[ai_model]", "Model / Version" %>
        <%= text_field_tag "settings[ai_model]", @settings["ai_model"],
              placeholder: "qwen2.5:7b" %>
        <div class="hint">
          Ollama: qwen2.5:7b &nbsp;|&nbsp; Gemini: gemini-2.0-flash-lite &nbsp;|&nbsp;
          OpenAI: gpt-4o-mini &nbsp;|&nbsp; Anthropic: claude-3-5-haiku-20241022
        </div>
      </div>
      <div class="field">
        <%= label_tag "settings[ai_base_url]", "Base URL (Ollama / custom endpoint)" %>
        <%= text_field_tag "settings[ai_base_url]", @settings["ai_base_url"],
              placeholder: "http://localhost:11434" %>
        <div class="hint">
          Leave empty to use the engine default.
          Ollama: <code>http://localhost:11434</code> &nbsp;|&nbsp;
          Anthropic: <code>https://api.anthropic.com</code>
        </div>
      </div>
      <div class="field">
        <%= label_tag "settings[ai_api_key]", "API Key" %>
        <%= password_field_tag "settings[ai_api_key]", @settings["ai_api_key"],
              placeholder: "Leave blank for Ollama",
              autocomplete: "new-password" %>
        <div class="hint">Gemini: free key at ai.google.dev &nbsp;|&nbsp; OpenAI: platform.openai.com/api-keys &nbsp;|&nbsp; Ollama: leave blank</div>
      </div>
    </div>

    <%# Grammar correction — Ollama/qwen only %>
    <div style="margin-top:1rem;padding-top:1rem;border-top:1px solid #dee2e6">
      <div class="field" style="margin-bottom:.5rem">
        <label style="display:flex;align-items:center;gap:.5rem;cursor:pointer">
          <%= hidden_field_tag "settings[grammar_correct]", "0" %>
          <%= check_box_tag "settings[grammar_correct]", "1",
                @settings["grammar_correct"] != "0",
                style: "width:1rem;height:1rem;cursor:pointer" %>
          <span><strong>Grammar correction</strong> — fix Ollama/qwen response grammar via
            <a href="https://languagetool.org" target="_blank">LanguageTool</a>
            before sending to users (enabled by default)</span>
        </label>
      </div>
      <div class="field">
        <%= label_tag "settings[languagetool_url]", "LanguageTool URL (optional)" %>
        <%= text_field_tag "settings[languagetool_url]", @settings["languagetool_url"],
              placeholder: "Leave blank for free public API (api.languagetool.org)" %>
        <div class="hint">
          Only needed if you run a
          <a href="https://github.com/languagetool-org/languagetool#docker" target="_blank">self-hosted LanguageTool instance</a>
          (e.g. <code>http://localhost:8010</code>). The free public API has a 20 req/min limit.
        </div>
      </div>
    </div>
  </div>

  <%# ── Text-to-Speech ─────────────────────────────────────────────────────── %>
  <div class="card">
    <div class="card-title">🔊 Text-to-Speech (spoken AI responses)</div>
    <p class="hint" style="margin-bottom:.9rem">
      When a voice command cannot be handled by an app action (e.g. <em>"What was my last WhatsApp message?"</em>),
      the AI's response is read aloud through the car speakers.
      Powered by <a href="https://github.com/remsky/Kokoro-FastAPI" target="_blank">Kokoro-FastAPI</a>
      (recommended) or any OpenAI-compatible <code>/v1/audio/speech</code> endpoint.
      <br>Quick start: <code>docker run -p 8880:8880 ghcr.io/remsky/kokoro-fastapi-cpu:v0.2.2</code>
    </p>
    <div class="fields-grid">
      <div class="field">
        <%= label_tag "settings[tts_url]", "TTS Server URL" %>
        <%= text_field_tag "settings[tts_url]", @settings["tts_url"],
              placeholder: "http://localhost:8880  (leave blank to disable TTS)" %>
        <div class="hint">Root URL of the TTS server — the endpoint <code>/v1/audio/speech</code> is appended automatically.</div>
      </div>
      <div class="field">
        <%= label_tag "settings[tts_voice]", "Speaker Voice" %>
        <%= select_tag "settings[tts_voice]",
              options_for_select(Api::TtsController::VOICES.map { |id, label| [label, id] },
                                 @settings["tts_voice"].presence || "af_heart") %>
        <div class="hint">Voice used for all spoken responses. Voices are Kokoro identifiers; other TTS servers may use different IDs.</div>
      </div>
      <div class="field">
        <%= label_tag "settings[tts_model]", "TTS Model name" %>
        <%= text_field_tag "settings[tts_model]", @settings["tts_model"],
              placeholder: "kokoro" %>
        <div class="hint">Kokoro: <code>kokoro</code> &nbsp;·&nbsp; Leave blank for server default.</div>
      </div>
    </div>
  </div>

  <%# ── Log Server ─────────────────────────────────────────────────────────── %>
  <div class="card">
    <div class="card-title">📄 Command Log (freespeech_log_server.py)</div>
    <div class="fields-grid">
      <div class="field">
        <%= label_tag "settings[log_jsonl_path]", "JSONL Log File Path" %>
        <%= text_field_tag "settings[log_jsonl_path]", @settings["log_jsonl_path"],
              placeholder: "/var/log/freespeech/freespeech_commands.jsonl" %>
        <div class="hint">Absolute path to the rolling JSONL log written by the Python server. Used by the History tab.</div>
      </div>
      <div class="field">
        <%= label_tag "settings[log_audio_dir]", "WAV Audio Directory" %>
        <%= text_field_tag "settings[log_audio_dir]", @settings["log_audio_dir"],
              placeholder: "/var/log/freespeech/audio" %>
        <div class="hint">Directory where the Python server stores WAV recordings.</div>
      </div>
      <div class="field">
        <%= label_tag "settings[log_max_entries]", "Max Log Entries (rolling)" %>
        <%= number_field_tag "settings[log_max_entries]", @settings["log_max_entries"],
              min: 100, max: 10_000, step: 100 %>
      </div>
      <div class="field">
        <%= label_tag "settings[log_max_wavs]", "Max WAV Files Kept" %>
        <%= number_field_tag "settings[log_max_wavs]", @settings["log_max_wavs"],
              min: 10, max: 1_000, step: 10 %>
      </div>
    </div>
  </div>

  <div style="text-align:right; margin-bottom:2rem">
    <%= f.submit "💾  Save Settings", class: "btn btn-primary", style: "font-size:.95rem;padding:.55rem 1.4rem" %>
  </div>
<% end %>

<%# ── Custom Topic → App Mappings ───────────────────────────────────────────── %>
<div class="card">
  <div class="card-title">🗂 Custom Topic → App Mappings</div>
  <p class="hint" style="margin-bottom:.9rem">
    Extend the voice assistant with flexible topic-to-app mappings using the
    <strong>ping-pong mechanism</strong>: the AI first detects whether the user's
    statement relates to a topic (<em>ping</em>), then transforms it into the
    app-specific search query (<em>pong</em>).
    <br>
    Example: <em>"I could really go for french fries"</em> →
    topic: <strong>Eating</strong> →
    pong query: <em>"french fries near me"</em> →
    <code>yelp://search?terms=french+fries+near+me</code>
    <br>
    Use <code>{query}</code> as the placeholder in the URI template.
  </p>

  <%# Existing topics table %>
  <% if @custom_topics.any? %>
    <div style="overflow-x:auto;margin-bottom:1rem">
      <table style="width:100%;border-collapse:collapse;font-size:.85rem">
        <thead>
          <tr style="border-bottom:2px solid #dee2e6;text-align:left">
            <th style="padding:.4rem .6rem">Topic (AI key)</th>
            <th style="padding:.4rem .6rem">Description</th>
            <th style="padding:.4rem .6rem">App</th>
            <th style="padding:.4rem .6rem">URI Template</th>
            <th style="padding:.4rem .6rem"></th>
          </tr>
        </thead>
        <tbody>
          <% @custom_topics.each do |t| %>
            <tr style="border-bottom:1px solid #f1f3f5">
              <td style="padding:.5rem .6rem">
                <strong><%= t.name %></strong><br>
                <code style="font-size:.75em;color:#6c757d"><%= t.slug %></code>
              </td>
              <td style="padding:.5rem .6rem;color:#495057"><%= t.description %></td>
              <td style="padding:.5rem .6rem">
                <%= t.app_label %>
                <% if t.android_package.present? %>
                  <br><code style="font-size:.72em;color:#6c757d"><%= t.android_package %></code>
                <% end %>
              </td>
              <td style="padding:.5rem .6rem;word-break:break-all">
                <code style="font-size:.78em"><%= t.uri_template %></code>
                <% if t.transform_hint.present? %>
                  <br><span style="font-size:.75em;color:#6c757d;font-style:italic">Hint: <%= t.transform_hint %></span>
                <% end %>
              </td>
              <td style="padding:.5rem .6rem;white-space:nowrap">
                <%= form_with url: custom_topic_path(t), method: :delete, local: true,
                      data: { confirm: "Remove "#{t.name}"?" } do %>
                  <button type="submit" class="btn btn-danger" style="padding:.2rem .6rem;font-size:.8rem">✕</button>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="hint" style="margin-bottom:.9rem">No custom topics yet. Add one below.</p>
  <% end %>

  <%# Add topic form %>
  <%= form_with url: custom_topics_path, method: :post, local: true do |f| %>
    <div style="border-top:1px solid #dee2e6;padding-top:.9rem">
      <div class="hint" style="margin-bottom:.6rem;font-weight:600">Add a new topic</div>
      <div class="fields-grid" style="grid-template-columns:repeat(auto-fill,minmax(220px,1fr))">
        <div class="field">
          <%= label_tag "custom_topic[name]", "Topic name *" %>
          <%= text_field_tag "custom_topic[name]", nil, placeholder: "Eating", required: true %>
          <div class="hint">Short word or phrase. Becomes <code>CUSTOM_NAME</code> in the AI prompt.</div>
        </div>
        <div class="field">
          <%= label_tag "custom_topic[description]", "Description for AI *" %>
          <%= text_field_tag "custom_topic[description]", nil,
                placeholder: "Finding restaurants, food, places to eat", required: true %>
          <div class="hint">Helps the AI decide when this topic applies. Be specific.</div>
        </div>
        <div class="field">
          <%= label_tag "custom_topic[app_label]", "App label *" %>
          <%= text_field_tag "custom_topic[app_label]", nil, placeholder: "Yelp", required: true %>
        </div>
        <div class="field">
          <%= label_tag "custom_topic[android_package]", "Android package (optional)" %>
          <%= text_field_tag "custom_topic[android_package]", nil, placeholder: "com.yelp.android" %>
          <div class="hint">Preferred app. Leave blank for any URI handler.</div>
        </div>
        <div class="field" style="grid-column:span 2">
          <%= label_tag "custom_topic[uri_template]", "URI template * — use {query} as placeholder" %>
          <%= text_field_tag "custom_topic[uri_template]", nil,
                placeholder: "https://www.yelp.com/search?find_desc={query}", required: true,
                style: "font-family:monospace;font-size:.85rem" %>
          <div class="hint">
            Examples: &nbsp;
            <code>yelp://search?terms={query}</code> &nbsp;·&nbsp;
            <code>geo:0,0?q={query}+restaurant</code> &nbsp;·&nbsp;
            <code>vnd.youtube:///search?q={query}</code> &nbsp;·&nbsp;
            <code>https://www.amazon.com/s?k={query}</code>
          </div>
        </div>
        <div class="field" style="grid-column:span 2">
          <%= label_tag "custom_topic[transform_hint]", "Query transform hint (optional)" %>
          <%= text_field_tag "custom_topic[transform_hint]", nil,
                placeholder: "Phrase as a local restaurant or food search." %>
          <div class="hint">Extra instruction for the pong LLM call to improve query quality.</div>
        </div>
      </div>
      <div style="margin-top:.75rem">
        <button type="submit" class="btn btn-primary btn-sm">+ Add Topic</button>
      </div>
    </div>
  <% end %>
</div>

<%# ── Languages ───────────────────────────────────────────────────────────── %>
<div class="card">
  <div class="card-title">🌐 Supported Languages</div>
  <p class="hint" style="margin-bottom:.9rem">
    English, German and French are always present and cannot be removed.
    Added languages appear in the FreeSpeech app language selector and are included in the
    <a href="/api/languages" target="_blank">/api/languages</a> feed.
  </p>

  <div class="lang-list">
    <% @languages.each do |lang| %>
      <div class="lang-pill <%= 'protected' if lang.protected? %>">
        <%= lang.name %> <code style="font-size:.75em;color:#495057"><%= lang.code %></code>
        <% if lang.protected? %>
          <span class="lock" title="Protected — always active">🔒</span>
        <% else %>
          <%= form_with url: language_path(lang), method: :delete, local: true,
                        data: { confirm: "Remove #{lang.name}?" } do %>
            <button type="submit" class="btn btn-danger" title="Remove <%= lang.name %>">✕</button>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>

  <%# Add language form %>
  <%= form_with url: languages_path, method: :post, local: true do |f| %>
    <div class="add-lang">
      <div class="field">
        <%= label_tag "language[code]", "BCP-47 code" %>
        <%= text_field_tag "language[code]", nil,
              placeholder: "e.g. pt, zh-TW, ru",
              maxlength: 10, style: "max-width:140px" %>
      </div>
      <div class="field">
        <%= label_tag "language[name]", "Language name" %>
        <%= text_field_tag "language[name]", nil,
              placeholder: "e.g. Portuguese" %>
      </div>
      <%= f.submit "+ Add Language", class: "btn btn-primary btn-sm",
            style: "white-space:nowrap;align-self:flex-end;margin-bottom:2px" %>
    </div>
  <% end %>
</div>

<%# ── SMTP ────────────────────────────────────────────────────────────────── %>
<div class="card">
  <div class="card-title">📧 Email (SMTP) — for account confirmation</div>
  <p class="hint" style="margin-bottom:.9rem">
    Leave <em>Host</em> blank to disable email. Users can still be confirmed manually
    on the <a href="<%= admin_users_path %>">Users page</a>.
  </p>
  <%= form_with url: config_path, method: :patch, local: true do %>
    <div class="fields-grid">
      <div class="field">
        <%= label_tag "settings[smtp_host]", "SMTP Host" %>
        <%= text_field_tag "settings[smtp_host]", @settings["smtp_host"], placeholder: "smtp.example.com" %>
      </div>
      <div class="field">
        <%= label_tag "settings[smtp_port]", "SMTP Port" %>
        <%= number_field_tag "settings[smtp_port]", @settings["smtp_port"], placeholder: "587" %>
      </div>
      <div class="field">
        <%= label_tag "settings[smtp_user]", "SMTP Username" %>
        <%= text_field_tag "settings[smtp_user]", @settings["smtp_user"] %>
      </div>
      <div class="field">
        <%= label_tag "settings[smtp_password]", "SMTP Password" %>
        <%= password_field_tag "settings[smtp_password]", @settings["smtp_password"],
              autocomplete: "new-password" %>
      </div>
      <div class="field">
        <%= label_tag "settings[smtp_from]", "From address" %>
        <%= text_field_tag "settings[smtp_from]", @settings["smtp_from"],
              placeholder: "freespeech@yourdomain.com" %>
      </div>
      <div class="field">
        <%= label_tag "settings[app_host]", "App host (for email links)" %>
        <%= text_field_tag "settings[app_host]", @settings["app_host"],
              placeholder: "pittyvaich:3001" %>
        <div class="hint">Used to build confirmation URLs in emails.</div>
      </div>
    </div>
    <button type="submit" class="btn btn-primary">💾 Save Email Settings</button>
  <% end %>
</div>

<%# ── API reference ────────────────────────────────────────────────────────── %>
<div class="card" style="border-style:dashed">
  <div class="card-title" style="font-size:.85rem">🔌 JSON API</div>
  <p class="hint">
    Android app → server-side AI: <code>POST <a href="/api/classify" target="_blank">/api/classify</a></code> (optional Bearer token)<br>
    Android app → spoken response: <code>POST /api/tts</code> body: <code>{"text":"…"}</code> → audio/wav<br>
    Live config feed: <a href="/api/config" target="_blank"><code>/api/config</code></a>
    &nbsp;|&nbsp;
    <a href="/api/languages" target="_blank"><code>/api/languages</code></a>
    <br><span style="font-size:.78rem">API key is never exposed via the API.</span>
  </p>
</div>
