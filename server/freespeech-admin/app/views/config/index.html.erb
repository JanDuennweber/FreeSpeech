<h2 style="margin-bottom:1.2rem">Configuration</h2>

<%= form_with url: config_path, method: :patch, local: true do |f| %>

  <%# ── Whisper ─────────────────────────────────────────────────────────────── %>
  <div class="card">
    <div class="card-title">🔊 Whisper Transcription Server</div>
    <div class="fields-grid">
      <div class="field">
        <%= label_tag "settings[whisper_url]", "Endpoint URL" %>
        <%= text_field_tag "settings[whisper_url]", @settings["whisper_url"],
              placeholder: "http://localhost:8080/v1/audio/transcriptions" %>
        <div class="hint">OpenAI-compatible transcription endpoint (faster-whisper, whisper.cpp, LocalAI, …)</div>
      </div>
      <div class="field">
        <%= label_tag "settings[whisper_model]", "Model" %>
        <%= text_field_tag "settings[whisper_model]", @settings["whisper_model"],
              placeholder: "large-v3" %>
        <div class="hint">Whisper model name passed to the server (large-v3, medium, small, …)</div>
      </div>
    </div>
  </div>

  <%# ── AI Classification ──────────────────────────────────────────────────── %>
  <div class="card">
    <div class="card-title">🤖 AI Command Classification</div>
    <div class="fields-grid">
      <div class="field">
        <%= label_tag "settings[ai_engine]", "Engine" %>
        <%= select_tag "settings[ai_engine]",
              options_for_select([
                ["Ollama (local / private)",        "ollama"],
                ["Gemini (free, Google)",            "gemini"],
                ["OpenAI / GPT",                     "openai"],
                ["Anthropic / Claude",               "anthropic"],
              ], @settings["ai_engine"]) %>
        <div class="hint">Which AI backend classifies voice commands into music / navigation / weather / …</div>
      </div>
      <div class="field">
        <%= label_tag "settings[ai_model]", "Model / Version" %>
        <%= text_field_tag "settings[ai_model]", @settings["ai_model"],
              placeholder: "qwen2.5:7b" %>
        <div class="hint">
          Ollama: qwen2.5:7b &nbsp;|&nbsp; Gemini: gemini-2.0-flash-lite &nbsp;|&nbsp;
          OpenAI: gpt-4o-mini &nbsp;|&nbsp; Anthropic: claude-3-5-haiku-20241022
        </div>
      </div>
      <div class="field">
        <%= label_tag "settings[ai_base_url]", "Base URL (Ollama / custom endpoint)" %>
        <%= text_field_tag "settings[ai_base_url]", @settings["ai_base_url"],
              placeholder: "http://localhost:11434" %>
        <div class="hint">
          Leave empty to use the engine default.
          Ollama: <code>http://localhost:11434</code> &nbsp;|&nbsp;
          Anthropic: <code>https://api.anthropic.com</code>
        </div>
      </div>
      <div class="field">
        <%= label_tag "settings[ai_api_key]", "API Key" %>
        <%= password_field_tag "settings[ai_api_key]", @settings["ai_api_key"],
              placeholder: "Leave blank for Ollama",
              autocomplete: "new-password" %>
        <div class="hint">Gemini: free key at ai.google.dev &nbsp;|&nbsp; OpenAI: platform.openai.com/api-keys &nbsp;|&nbsp; Ollama: leave blank</div>
      </div>
    </div>
  </div>

  <%# ── Log Server ─────────────────────────────────────────────────────────── %>
  <div class="card">
    <div class="card-title">📄 Command Log (freespeech_log_server.py)</div>
    <div class="fields-grid">
      <div class="field">
        <%= label_tag "settings[log_jsonl_path]", "JSONL Log File Path" %>
        <%= text_field_tag "settings[log_jsonl_path]", @settings["log_jsonl_path"],
              placeholder: "/var/log/freespeech/freespeech_commands.jsonl" %>
        <div class="hint">Absolute path to the rolling JSONL log written by the Python server. Used by the History tab.</div>
      </div>
      <div class="field">
        <%= label_tag "settings[log_audio_dir]", "WAV Audio Directory" %>
        <%= text_field_tag "settings[log_audio_dir]", @settings["log_audio_dir"],
              placeholder: "/var/log/freespeech/audio" %>
        <div class="hint">Directory where the Python server stores WAV recordings.</div>
      </div>
      <div class="field">
        <%= label_tag "settings[log_max_entries]", "Max Log Entries (rolling)" %>
        <%= number_field_tag "settings[log_max_entries]", @settings["log_max_entries"],
              min: 100, max: 10_000, step: 100 %>
      </div>
      <div class="field">
        <%= label_tag "settings[log_max_wavs]", "Max WAV Files Kept" %>
        <%= number_field_tag "settings[log_max_wavs]", @settings["log_max_wavs"],
              min: 10, max: 1_000, step: 10 %>
      </div>
    </div>
  </div>

  <div style="text-align:right; margin-bottom:2rem">
    <%= f.submit "💾  Save Settings", class: "btn btn-primary", style: "font-size:.95rem;padding:.55rem 1.4rem" %>
  </div>
<% end %>

<%# ── Languages ───────────────────────────────────────────────────────────── %>
<div class="card">
  <div class="card-title">🌐 Supported Languages</div>
  <p class="hint" style="margin-bottom:.9rem">
    English, German and French are always present and cannot be removed.
    Added languages appear in the FreeSpeech app language selector and are included in the
    <a href="/api/languages" target="_blank">/api/languages</a> feed.
  </p>

  <div class="lang-list">
    <% @languages.each do |lang| %>
      <div class="lang-pill <%= 'protected' if lang.protected? %>">
        <%= lang.name %> <code style="font-size:.75em;color:#495057"><%= lang.code %></code>
        <% if lang.protected? %>
          <span class="lock" title="Protected — always active">🔒</span>
        <% else %>
          <%= form_with url: language_path(lang), method: :delete, local: true,
                        data: { confirm: "Remove #{lang.name}?" } do %>
            <button type="submit" class="btn btn-danger" title="Remove <%= lang.name %>">✕</button>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>

  <%# Add language form %>
  <%= form_with url: languages_path, method: :post, local: true do |f| %>
    <div class="add-lang">
      <div class="field">
        <%= label_tag "language[code]", "BCP-47 code" %>
        <%= text_field_tag "language[code]", nil,
              placeholder: "e.g. pt, zh-TW, ru",
              maxlength: 10, style: "max-width:140px" %>
      </div>
      <div class="field">
        <%= label_tag "language[name]", "Language name" %>
        <%= text_field_tag "language[name]", nil,
              placeholder: "e.g. Portuguese" %>
      </div>
      <%= f.submit "+ Add Language", class: "btn btn-primary btn-sm",
            style: "white-space:nowrap;align-self:flex-end;margin-bottom:2px" %>
    </div>
  <% end %>
</div>

<%# ── SMTP ────────────────────────────────────────────────────────────────── %>
<div class="card">
  <div class="card-title">📧 Email (SMTP) — for account confirmation</div>
  <p class="hint" style="margin-bottom:.9rem">
    Leave <em>Host</em> blank to disable email. Users can still be confirmed manually
    on the <a href="<%= admin_users_path %>">Users page</a>.
  </p>
  <%= form_with url: config_path, method: :patch, local: true do %>
    <div class="fields-grid">
      <div class="field">
        <%= label_tag "settings[smtp_host]", "SMTP Host" %>
        <%= text_field_tag "settings[smtp_host]", @settings["smtp_host"], placeholder: "smtp.example.com" %>
      </div>
      <div class="field">
        <%= label_tag "settings[smtp_port]", "SMTP Port" %>
        <%= number_field_tag "settings[smtp_port]", @settings["smtp_port"], placeholder: "587" %>
      </div>
      <div class="field">
        <%= label_tag "settings[smtp_user]", "SMTP Username" %>
        <%= text_field_tag "settings[smtp_user]", @settings["smtp_user"] %>
      </div>
      <div class="field">
        <%= label_tag "settings[smtp_password]", "SMTP Password" %>
        <%= password_field_tag "settings[smtp_password]", @settings["smtp_password"],
              autocomplete: "new-password" %>
      </div>
      <div class="field">
        <%= label_tag "settings[smtp_from]", "From address" %>
        <%= text_field_tag "settings[smtp_from]", @settings["smtp_from"],
              placeholder: "freespeech@yourdomain.com" %>
      </div>
      <div class="field">
        <%= label_tag "settings[app_host]", "App host (for email links)" %>
        <%= text_field_tag "settings[app_host]", @settings["app_host"],
              placeholder: "pittyvaich:3001" %>
        <div class="hint">Used to build confirmation URLs in emails.</div>
      </div>
    </div>
    <button type="submit" class="btn btn-primary">💾 Save Email Settings</button>
  <% end %>
</div>

<%# ── API reference ────────────────────────────────────────────────────────── %>
<div class="card" style="border-style:dashed">
  <div class="card-title" style="font-size:.85rem">🔌 JSON API</div>
  <p class="hint">
    Android app → server-side AI: <code>POST <a href="/api/classify" target="_blank">/api/classify</a></code> (optional Bearer token)<br>
    Live config feed: <a href="/api/config" target="_blank"><code>/api/config</code></a>
    &nbsp;|&nbsp;
    <a href="/api/languages" target="_blank"><code>/api/languages</code></a>
    <br><span style="font-size:.78rem">API key is never exposed via the API.</span>
  </p>
</div>
