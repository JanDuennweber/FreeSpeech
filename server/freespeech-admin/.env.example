# Copy this file to .env and fill in the values before starting the container.
# The .env file is git-ignored and must never be committed to the repository.

# ── Rails runtime ─────────────────────────────────────────────────────────────
RAILS_ENV=production
PORT=3001

# Generate with:  docker compose run --rm freespeech-console bundle exec rails secret
SECRET_KEY_BASE=replace-with-output-of-rails-secret

RAILS_LOG_TO_STDOUT=true
RAILS_MAX_THREADS=3

# ── Initial admin account (created on first start via db:seed) ────────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-immediately

# ── Data paths inside the container (match the volume mounts in docker-compose) ─
LOG_JSONL_PATH=/data/logs/freespeech_commands.jsonl
LOG_AUDIO_DIR=/data/audio

# ── After the first login, configure everything else via the Console UI ───────
# In Config → Whisper:      http://host.docker.internal:18080/v1/audio/transcriptions
# In Config → AI Base URL:  http://host.docker.internal:11434
# In Config → TTS URL:      http://host.docker.internal:8880
#
# host.docker.internal resolves to the host (im-pittyvaich) from inside the container,
# reaching the SSH tunnel endpoints forwarded from im-lochlea.
# Port 18080 is used for Whisper to avoid conflict with the nginx-reserved port 8080.
